---
import Main from "../layouts/Main.astro";
import LandingHero from "../components/sections/landing/LandingHero.astro";
import AboutMission from "../components/sections/shared/AboutMission.astro";
import LandingProducts from "../components/sections/landing/LandingProducts.astro";
import WhyUs from "../components/sections/landing/WhyUs.astro";
import LandingServices from "../components/sections/landing/LandingServices.astro";
import CTABannerSplit from "../components/sections/shared/CTABannerSplit.astro";
import OurWork from "../components/sections/shared/OurWork.astro";
import ContactFull from "../components/sections/shared/ContactFull.astro";
import Testimonials from "../components/sections/shared/Testimonials.astro";
import CTABannerCenter from "../components/sections/shared/CTABannerCenter.astro";

import { bannerLPData } from "../data/banner-data";
---

<Main title="PerfectView">
  <LandingHero />
  <AboutMission client:load />

  <LandingProducts client:visible />
  <WhyUs client:visible />
  <LandingServices client:visible />
  <CTABannerSplit
    image={bannerLPData.image}
    content={bannerLPData.content}
    client:visible
  />
  <OurWork client:visible />
  <ContactFull client:visible />
  <Testimonials client:visible />
  <CTABannerCenter client:visible />
</Main>
