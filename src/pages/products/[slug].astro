---
import Inner from "../../layouts/Inner.astro";
import ProductHero from "../../components/sections/product/ProductHero.astro";
import ProductBenefits from "../../components/sections/product/ProductBenefits.astro";
import ProductFeatures from "../../components/sections/product/ProductFeatures.astro";
import ProductEnhance from "../../components/sections/product/ProductEnhance.astro";
import CTABannerSplit from "../../components/sections/shared/CTABannerSplit.astro";
import {
  productBannerData,
  defaultProductBanner,
} from "../../data/product-banner";
import { PRODUCT_SLUGS } from "../../data/products";
import { getProductBenefits } from "../../data/product-benefits";

export async function getStaticPaths() {
  return PRODUCT_SLUGS.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as (typeof PRODUCT_SLUGS)[number];
const productBanner = productBannerData[slug] || defaultProductBanner;

const benefits = getProductBenefits(slug);
const pageTitle = benefits
  ? benefits.title.replace(/^Benefits of\s+/, "")
  : slug.replace(/-/g, " ").replace(/\b\w/g, (m) => m.toUpperCase());

const productMetaDescriptions: Record<(typeof PRODUCT_SLUGS)[number], string> = {
  "roman-shades":
    "Custom Roman shades from PerfectView — fabric shades that stack into neat folds, with cordless and motorized options. Professional installation in Utah.",
  "roller-shades":
    "Custom roller shades from PerfectView — clean, minimal shades in sheer-to-blackout fabrics with cordless and motorized options. Installed throughout Utah.",
  "cellular-shades":
    "Custom cellular shades from PerfectView — energy-efficient honeycomb shades with light filtering to blackout options. Professional installation throughout Utah.",
  "wood-faux-blinds":
    "Custom wood and faux wood blinds from PerfectView — classic slatted blinds in real or moisture-resistant faux wood, made to measure in Utah.",
  shutters:
    "Custom plantation shutters from PerfectView — hardwood and composite shutters with adjustable louvers for privacy and light control. Serving Utah.",
  draperies:
    "Custom draperies from PerfectView — tailored fabric panels and headers with liner options for insulation and blackout. Installed throughout Utah.",
  "exterior-shades":
    "Custom exterior shades from PerfectView — outdoor-rated solar screens that block heat and glare on patios, decks, and large exposures throughout Utah.",
  "sheer-layered":
    "Custom sheer and layered shades from PerfectView — soft light diffusion and on-demand privacy with a modern, streamlined look. Installed throughout Utah.",
  "natural-woven":
    "Custom natural woven shades from PerfectView — handcrafted bamboo, grass, and reed shades that add texture and warmth to Utah homes.",
};

const productSeoTitles: Record<(typeof PRODUCT_SLUGS)[number], string> = {
  "roman-shades": "Custom Roman Shades in Utah | PerfectView Window Coverings",
  "roller-shades":
    "Custom Roller Shades in Utah | PerfectView Window Coverings",
  "cellular-shades": "Cellular Shades in Utah | PerfectView Window Coverings",
  "wood-faux-blinds": "Wood & Faux Wood Blinds in Utah | PerfectView",
  shutters: "Plantation Shutters in Utah | PerfectView Window Coverings",
  draperies: "Custom Draperies in Utah | PerfectView Window Coverings",
  "exterior-shades": "Exterior Shades in Utah | PerfectView Window Coverings",
  "sheer-layered":
    "Sheer & Layered Shades in Utah | PerfectView Window Coverings",
  "natural-woven":
    "Natural Woven Shades in Utah | PerfectView Window Coverings",
};

const pageDescription = productMetaDescriptions[slug];
const seoTitle = productSeoTitles[slug];
---

<Inner
  heading={pageTitle}
  breadcrumbItems={[
    { label: "Home", href: "/" },
    { label: "Products", href: "/products" },
    { label: pageTitle },
  ]}
  title={seoTitle}
  description={pageDescription}
>
  <ProductHero slug={slug} />
  <ProductEnhance slug={slug} />
  <CTABannerSplit {...productBanner} />
  <div class="product-group container">
    <ProductFeatures slug={slug} />
    <ProductBenefits slug={slug} />
  </div>
</Inner>
