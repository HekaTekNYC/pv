---
import Inner from "../../layouts/Inner.astro";
import ProductHero from "../../components/sections/product/ProductHero.astro";
import ProductBenefits from "../../components/sections/product/ProductBenefits.astro";
import ProductFeatures from "../../components/sections/product/ProductFeatures.astro";
import ProductEnhance from "../../components/sections/product/ProductEnhance.astro";
import CTABannerSplit from "../../components/sections/shared/CTABannerSplit.astro";
import {
  productBannerData,
  defaultProductBanner,
} from "../../data/product-banner";
import { PRODUCT_SLUGS } from "../../data/products";
import { getProductBenefits } from "../../data/product-benefits";

export async function getStaticPaths() {
  return PRODUCT_SLUGS.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as (typeof PRODUCT_SLUGS)[number];
const productBanner = productBannerData[slug] || defaultProductBanner;

const benefits = getProductBenefits(slug);
const pageTitle = benefits
  ? benefits.title.replace(/^Benefits of\s+/, "")
  : slug.replace(/-/g, " ").replace(/\b\w/g, (m) => m.toUpperCase());

const productMetaDescriptions: Record<(typeof PRODUCT_SLUGS)[number], string> = {
  "roman-shades":
    "Custom Roman shades from PerfectView Window Coverings — fabric shades that stack into neat folds, with cordless and motorized options for any space.",
  "roller-shades":
    "Custom roller shades from PerfectView Window Coverings — clean, minimal shades in sheer-to-blackout fabrics with cordless and motorized options.",
  "cellular-shades":
    "Custom cellular shades from PerfectView Window Coverings — energy-efficient honeycomb shades with light filtering to blackout options.",
  "wood-faux-blinds":
    "Custom wood and faux wood blinds from PerfectView Window Coverings — classic slatted blinds in real or moisture-resistant faux wood, made to measure.",
  shutters:
    "Custom shutters from PerfectView Window Coverings — durable hardwood and composite plantation shutters with adjustable louvers for privacy and light control.",
  draperies:
    "Custom draperies from PerfectView Window Coverings — tailored fabric panels and headers with liner options for insulation and blackout.",
  "exterior-shades":
    "Custom exterior shades from PerfectView Window Coverings — outdoor-rated solar screens that block heat and glare on patios, decks, and large exposures.",
  "sheer-layered":
    "Custom sheer and layered shades from PerfectView Window Coverings — soft light diffusion and on-demand privacy with a modern, streamlined look.",
  "natural-woven":
    "Custom natural woven shades from PerfectView Window Coverings — handcrafted bamboo, grass, and reed shades that add texture and warmth to any room.",
};

const pageDescription = productMetaDescriptions[slug];
const seoTitle = `${pageTitle} | Custom Window Treatments | PerfectView`;
---

<Inner
  heading={pageTitle}
  breadcrumbItems={[
    { label: "Home", href: "/" },
    { label: "Products", href: "/products" },
    { label: pageTitle },
  ]}
  title={seoTitle}
  description={pageDescription}
>
  <ProductHero slug={slug} />
  <ProductEnhance slug={slug} />
  <CTABannerSplit {...productBanner} />
  <div class="product-group container">
    <ProductFeatures slug={slug} />
    <ProductBenefits slug={slug} />
  </div>
</Inner>
