---
import Inner from "../../layouts/Inner.astro";
import ProductsHero from "../../components/sections/products/ProductsHero.astro";
import ProductsGallery from "../../components/sections/products/ProductsGallery.astro";
import ProductGuide from "../../components/sections/products/ProductGuide.astro";
import CTABannerSplit from "../../components/sections/shared/CTABannerSplit.astro";
import { bannerProductsData } from "../../data/banner-data";

const title = "Custom Window Coverings & Treatments | PerfectView";
const description =
  "Explore PerfectView's full line of custom window treatments, including roller shades, cellular shades, wood blinds, shutters, draperies, and more.";
---

<Inner
  heading="Products"
  breadcrumbItems={[{ label: "Home", href: "/" }, { label: "Products" }]}
  title={title}
  description={description}
>
  <ProductsHero />
  <ProductsGallery />
  <CTABannerSplit
    image={bannerProductsData.image}
    content={bannerProductsData.content}
  />
  <ProductGuide />
</Inner>
