---
import Inner from "../layouts/Inner.astro";
import ContactBasic from "../components/sections/contact/ContactBasic.astro";
import TrustBanner from "../components/sections/contact/TrustBanner.astro";
import ContactMap from "../components/sections/contact/ContactMap.astro";

const title = "Contact PerfectView Window Coverings | Free Consultation";
const description =
  "Schedule a free in-home consultation with PerfectView Window Coverings. Call, email, or send a message to get started on custom window treatments.";
---

<Inner
  heading="Contact"
  breadcrumbItems={[{ label: "Home", href: "/" }, { label: "Contact" }]}
  title={title}
  description={description}
>
  <ContactBasic />
  <TrustBanner />
  <ContactMap />
</Inner>
