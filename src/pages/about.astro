---
import Inner from "../layouts/Inner.astro";
import AboutClients from "../components/sections/about/AboutClients.astro";
import AboutMission from "../components/sections/shared/AboutMission.astro";
import ContactFull from "../components/sections/shared/ContactFull.astro";
import Testimonials from "../components/sections/shared/Testimonials.astro";
import AboutMeet from "../components/sections/about/AboutMeet.astro";

const title = "About PerfectView Window Coverings | Family-Owned in Utah";
const description =
  "Learn about PerfectView Window Coverings, a family-owned Utah business providing custom window treatments with personal service and expert craftsmanship.";
---

<Inner
  heading="About"
  breadcrumbItems={[{ label: "Home", href: "/" }, { label: "About" }]}
  title={title}
  description={description}
>
  <AboutMeet />
  <AboutClients />
  <AboutMission />
  <ContactFull />
  <Testimonials />
</Inner>
