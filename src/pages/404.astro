---
import Main from "../layouts/Main.astro";
import Button from "../components/ui/Button.astro";
---

<Main>
  <div class="not-found__container container">
    <div class="not-found">
      <p class="not-found__number" aria-hidden="true">404</p>
      <h1>We can't find that page.</h1>
      <p class="not-found__body">
        This page may have moved or no longer exists. Head back home or browse
        our window coverings to find what you need.
      </p>
      <div class="not-found__buttons">
        <Button href="/" color="secondary">Back to Home</Button>
        <Button href="/products" color="neutral">Browse Products</Button>
      </div>
    </div>
  </div>
</Main>

<style>
  .not-found__container {
    min-height: calc(100dvh - 104px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-top: -50px;
    gap: 16px;
  }

  .not-found__number {
    font-family: var(--ff-heading);
    font-size: clamp(7rem, 20vw, 14rem);
    font-weight: var(--fw-bold);
    color: var(--neutral-lighter);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .not-found h1 {
    margin: 0;
    color: var(--primary);
    font-weight: var(--fw-bold);
  }

  .not-found__body {
    max-width: 480px;
    color: var(--text);
  }

  .not-found__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    margin-top: 8px;
  }

  .not-found__buttons :global(.btn) {
    flex: 1;
    min-width: 160px;
  }
  @media (min-width: 1024px) {
    .not-found {
      margin-top: -100px;
    }
  }
</style>
