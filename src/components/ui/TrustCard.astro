---
const { icon, alt, text, href } = Astro.props;
---

<div class="trust-card">
  <img src={icon} width="32" height="32" alt={alt} loading="lazy" />
  {
    href ? (
      <p>
        <a href={href} class="trust-card__phone">
          {text}
        </a>
      </p>
    ) : (
      <p>{text} </p>
    )
  }
</div>

<style>
  .trust-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    background-color: var(--secondary-light);
    padding: 48px 24px;
    gap: 12px;
    width: 100%;
  }

  .trust-card p {
    color: var(--grey-10);
    text-align: center;
  }

  .trust-card__phone,
  .trust-card__phone:link,
  .trust-card__phone:visited,
  .trust-card__phone:active {
    color: var(--grey-10);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .trust-card__phone:hover {
    color: var(--grey-5);
  }

  @media (min-width: 1024px) {
    .trust-card {
      max-width: 415px;
    }
  }
</style>
