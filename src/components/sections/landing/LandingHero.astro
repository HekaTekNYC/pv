---
import Button from "../../ui/Button.astro";
import { getCloudinarySrc } from "../../../config/cloudinary";
const mobile400 = getCloudinarySrc(
  "lp-hero-mbl_pvrtlh",
  "jpg",
  "v1764613833",
  400,
);
const mobile600 = getCloudinarySrc(
  "lp-hero-mbl_pvrtlh",
  "jpg",
  "v1764613833",
  600,
);
const mobile800 = getCloudinarySrc(
  "lp-hero-mbl_pvrtlh",
  "jpg",
  "v1764613833",
  800,
);
const mobileSrcset = `${mobile400} 400w, ${mobile600} 600w, ${mobile800} 800w`;

const desktop1024 = getCloudinarySrc(
  "lp-hero-dsk_xhu0u5",
  "jpg",
  "v1764613868",
  1024,
);
const desktop1536 = getCloudinarySrc(
  "lp-hero-dsk_xhu0u5",
  "jpg",
  "v1764613868",
  1536,
);
const desktop2048 = getCloudinarySrc(
  "lp-hero-dsk_xhu0u5",
  "jpg",
  "v1764613868",
  2048,
);
const desktopSrcset = `${desktop1024} 1024w, ${desktop1536} 1536w, ${desktop2048} 2048w`;

// Add missing variables for data attributes
const mobileImg = mobile400;
const desktopImg = desktop1024;
---

<section class="lp-hero" aria-labelledby="hero-title">
  <picture class="lp-hero__bg">
    <!-- Mobile (≤ 1024px) -->
    <source
      srcset={mobileSrcset}
      type="image/jpeg"
      media="(max-width: 1024px)"
      sizes="100vw"
    />

    <!-- Desktop (> 1024px) -->
    <source
      srcset={desktopSrcset}
      type="image/jpeg"
      media="(min-width: 1025px)"
      sizes="100vw"
    />

    <!-- Fallback -->
    <img
      src={mobile400}
      alt="Modern living room with custom window treatments"
      width="400"
      height="400"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
    />
  </picture>

  <div class="lp-hero__overlay" aria-hidden="true"></div>
  <div class="container">
    <div class="lp-hero__content">
      <h1 id="hero-title">Transform Your Windows, Transform Your Space</h1>
      <p>
        Experience the difference professional installation makes—where every
        treatment fits perfectly, functions smoothly, and transforms your space
        with lasting beauty.
      </p>
      <div class="lp-hero__actions">
        <Button color="neutral" href="#home-contact-form">
          Schedule Free Consultation
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .lp-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(520px, calc(100svh - 112px), 900px);
    width: 100%;
    isolation: isolate;
    overflow: hidden;
  }

  .lp-hero__bg,
  .lp-hero__bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1;
    z-index: 1;
  }

  .lp-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(40, 43, 48, 0.83);
    z-index: 2;
    pointer-events: none;
  }

  .lp-hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    height: 100%;
    gap: 20px;
    z-index: 3;
  }

  .lp-hero__content p {
    color: var(--white);
  }

  .lp-hero__actions {
    margin-top: 0.25rem;
  }

  @media (min-width: 768px) {
    .lp-hero__content {
      align-items: start;
      width: 75%;
    }
  }

  @media (min-width: 992px) {
    .lp-hero {
      min-height: clamp(520px, calc(100svh - 144px), 900px);
    }

    .lp-hero__overlay {
      background: linear-gradient(
        90deg,
        rgba(40, 43, 48, 0.8) 0%,
        rgba(40, 43, 48, 0.8) 45%,
        rgba(40, 43, 48, 0.4) 60%,
        rgba(40, 43, 48, 0) 70%
      );
    }
  }

  @media (min-width: 1025px) {
    .lp-hero__content {
      width: 50%;
    }

    .lp-hero__content p {
      padding-right: 40px;
    }
    .lp-hero__bg,
    .lp-hero__bg img {
      aspect-ratio: 3840 / 2460;
    }
  }

  @media (min-width: 1200px) {
    .lp-hero__content {
      align-items: start;
    }
  }
</style>
