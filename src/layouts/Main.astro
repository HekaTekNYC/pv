---
import TopBanner from "../components/shells/TopBanner.astro";
import Navigation from "../components/shells/Navigation.astro";
import Footer from "../components/shells/Footer.astro";

import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const defaultDescription =
  "Professional window treatment installation service with free consultations. Blinds, shades, and drapery for residential and commercial properties.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="description" name="description" content={defaultDescription} />
    <title>{title}</title>
  </head>
  <body>
    <TopBanner />

    <Navigation />
    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
