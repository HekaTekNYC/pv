---
import TopBanner from "../components/shells/TopBanner.astro";
import Navigation from "../components/shells/Navigation.astro";
import Footer from "../components/shells/Footer.astro";
import { getCloudinarySrc } from "../config/cloudinary";

import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const defaultTitle = "PerfectView Window Coverings | Utah";
const defaultDescription =
  "Professional window treatment installation service with free consultations. Blinds, shades, and drapery for residential and commercial properties.";

const { title = defaultTitle, description = defaultDescription } =
  Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const logoURL = getCloudinarySrc("PV_Logo_qhfozx", "png", "v1763135913");

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
  "@id": "https://perfectviewutah.com/#business",
  name: "PerfectView Window Coverings",
  description:
    "Family-owned Utah window treatment company providing custom blinds, shades, shutters, draperies, and window coverings for homes and businesses throughout Northern Utah. Professional installation with personalized design guidance and free in-home consultations.",
  url: "https://perfectviewutah.com",
  image: logoURL,
  logo: logoURL,
  telephone: "+18016039035",
  email: "perfectviewutah@outlook.com",
  priceRange: "$$",
  foundingDate: "2025-03",
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:00",
      closes: "17:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: "08:00",
      closes: "15:00",
    },
  ],
  areaServed: [
    { "@type": "City", name: "Ogden" },
    { "@type": "City", name: "Roy" },
    { "@type": "City", name: "West Haven" },
    { "@type": "City", name: "North Ogden" },
    { "@type": "City", name: "South Ogden" },
    { "@type": "City", name: "Riverdale" },
    { "@type": "City", name: "Farr West" },
    { "@type": "City", name: "Layton" },
    { "@type": "City", name: "Clearfield" },
    { "@type": "City", name: "Kaysville" },
    { "@type": "City", name: "Syracuse" },
    { "@type": "City", name: "Clinton" },
    { "@type": "City", name: "Bountiful" },
    { "@type": "City", name: "Farmington" },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Window Treatment Products & Installation",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Roller Shade Installation",
          url: "https://perfectviewutah.com/products/roller-shades/",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Cellular Shade Installation",
          url: "https://perfectviewutah.com/products/cellular-shades/",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Sheer and Layered Shade Installation",
          url: "https://perfectviewutah.com/products/sheer-layered/",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Wood and Faux Wood Blind Installation",
          url: "https://perfectviewutah.com/products/wood-faux-blinds/",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Plantation Shutter Installation",
          url: "https://perfectviewutah.com/products/shutters/",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Natural Woven Shade Installation",
          url: "https://perfectviewutah.com/products/natural-woven/",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Roman Shade Installation",
          url: "https://perfectviewutah.com/products/roman-shades/",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Custom Drapery Installation",
          url: "https://perfectviewutah.com/products/draperies/",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Exterior Shade Installation",
          url: "https://perfectviewutah.com/products/exterior-shades/",
        },
      },
    ],
  },
  sameAs: [
    "https://www.facebook.com/perfectviewutah1",
    "https://www.instagram.com/perfectviewutah/",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={logoURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />

    <!-- Preload fonts -->
    <link
      rel="preload"
      href="/fonts/Baskervville/Baskervville-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Sora/Sora-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <TopBanner />

    <Navigation />
    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
