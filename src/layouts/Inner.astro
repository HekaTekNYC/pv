---
import Main from "./Main.astro";
import PageHeader from "../components/sections/shared/PageHeader.astro";
import CTABannerCenter from "../components/sections/shared/CTABannerCenter.astro";

export interface Props {
  heading: string;
  breadcrumbItems: Array<{
    label: string;
    href?: string;
  }>;
  title?: string;
  description?: string;
}

const { heading, breadcrumbItems, title, description } = Astro.props;
---

<Main title={title} description={description}>
  <PageHeader heading={heading} breadcrumbItems={breadcrumbItems} />
  <slot />
  <CTABannerCenter />
</Main>
